# Apache : tout ce qui ne correspond pas à un fichier réel est renvoyé vers index.php
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Sécurité : désactive l'affichage du contenu des dossiers.
Options -Indexes