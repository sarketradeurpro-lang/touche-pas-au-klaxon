{
    "name": "covoiturage/touche-pas-au-klaxon",
    "description": "Application MVC PHP de covoiturage inter-agences (Touche pas au klaxon)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12"
    },
    "autoload": {
        "psr-4": {
            "TouchePasAuKlaxon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TouchePasAuKlaxon\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}