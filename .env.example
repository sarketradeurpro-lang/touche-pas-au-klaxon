# ============================================================================
# Exemple de fichier d'environnement — Touche pas au klaxon
# ----------------------------------------------------------------------------
# Copiez ce fichier sous le nom .env à la racine du projet, puis renseignez
# les valeurs réelles. Le fichier .env n'est JAMAIS versionné (voir .gitignore).
#
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (bash)
# ============================================================================

# --- Compte applicatif (utilisé par l'application ET par bin/install.php) ----
# DSN complet MySQL/MariaDB. Adaptez le port si votre instance n'écoute pas
# sur 3310 (port par défaut de l'instance WAMP fournie pour ce projet).
DB_DSN=mysql:host=127.0.0.1;port=3310;dbname=covoiturage;charset=utf8mb4
DB_USER=covoiturage
# Mot de passe du compte applicatif. bin/install.php applique cette valeur
# au compte 'covoiturage' via ALTER USER : choisissez un mot de passe fort.
DB_PASSWORD=

# --- Compte administrateur du SGBD (UNIQUEMENT pour bin/install.php) --------
# Ces identifiants ne sont lus que par bin/install.php pour créer la base,
# les tables et le compte applicatif. Ils ne sont jamais utilisés par
# l'application en cours d'exécution.
# Vous pouvez aussi les passer en arguments :
#   php bin/install.php <hote> <port> <utilisateur_root> <mot_de_passe_root>
# (Exemple en local WAMP : utilisateur « root » et le mot de passe défini
#  dans phpMyAdmin. Ne versionnez jamais ces valeurs.)
ROOT_DB_USER=
ROOT_DB_PASSWORD=
